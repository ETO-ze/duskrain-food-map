AMAP_WEB_SERVICE_KEY=YOUR_AMAP_WEB_SERVICE_KEY
AMAP_JS_KEY=YOUR_AMAP_JS_KEY
AMAP_SECURITY_CODE=YOUR_AMAP_SECURITY_CODE
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Author workspace public URLs
FOOD_MAP_PUBLIC_BASE_URL=https://duskrain.cn/food-map
DUSKRAIN_HOME_URL=https://duskrain.cn/

# Invitation and password-reset email
FOOD_MAP_SMTP_HOST=smtp.gmail.com
FOOD_MAP_SMTP_PORT=587
FOOD_MAP_SMTP_USERNAME=YOUR_SMTP_USERNAME
FOOD_MAP_SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
FOOD_MAP_SMTP_FROM_EMAIL=YOUR_SMTP_USERNAME
FOOD_MAP_SMTP_FROM_NAME=DuskRain
FOOD_MAP_SMTP_USE_SSL=false

# Google and GitHub sign-in for the author workspace
FOOD_MAP_GOOGLE_OAUTH_ENABLED=false
FOOD_MAP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
FOOD_MAP_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
FOOD_MAP_GITHUB_OAUTH_ENABLED=false
FOOD_MAP_GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
FOOD_MAP_GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET

# Reserved for a future verified-SMS identity adapter. No phone UI is shown while false.
FOOD_MAP_PHONE_LOGIN_ENABLED=false
